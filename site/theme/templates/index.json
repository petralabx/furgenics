    "custom_liquid_4hB3kC": {
      "type": "custom-liquid",
      "disabled": true,
      "settings": {
        "custom_liquid": "<div class=\"slider-mobile-gutter page-width page-width-desktop scroll-trigger animate--slide-in why-section\">\n\n    <h2>Why Furgenics?</h2>\n    <h5>Premium Pet Grooming Products <br/>\n       Crafted With Natural Ingredients</h5>\n        <div class=\"row\">\n            <div class=\"data\">\n                <img src=\"https://cdn.shopify.com/s/files/1/0649/4653/6587/files/why-icon.png?v=1757676518\" alt=\"\">\n                <p>We believe that pet care is about more than just cleaning. Its about wellness, comfort and connection. That's why our pet care products are developed with pet friendly formulas that nourish fur, protect skin, and bring out natural shine.</p>\n                <p>Whether you are a pet store or salon looking to stock premium products or a pet owner wanting the best for your furry friend, Furgenics offers exceptional grooming solutions for all.</p>\n                <a href=\"/collections/all\" class=\"button\">Learn More <img src=\"https://cdn.shopify.com/s/files/1/0677/2080/6573/files/right-arrow-w.png?v=1728912790\"/></a>\n            </div>\n            <div class=\"img-box\">\n                <img src=\"https://cdn.shopify.com/s/files/1/0649/4653/6587/files/FURGENICS_WEB_GRAPHICS-01.png?v=1738303534\" alt=\"\">\n            </div>\n        </div>\n    </div>",
