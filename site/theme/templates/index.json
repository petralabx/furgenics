      "settings": {
        "custom_liquid": "<div class=\"slider-mobile-gutter page-width page-width-desktop scroll-trigger animate--slide-in shop-section\">\n  <ul class=\"category-list\">\n    <li>\n        <div class=\"img-box\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0649/4653/6587/files/shop-shampoos.jpg?v=1729709668\" alt=\"\"/>\n        </div>\n        <h3>Shop<br/> Shampoos</h3>\n    </li>\n    <li>\n        <div class=\"img-box\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0677/2080/6573/files/shop-dental-care.jpg?v=1729697259\" alt=\"\"/>\n        </div>\n        <h3>Shop<br/>\nDental Care</h3>\n    </li>\n    <li>\n        <div class=\"img-box\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0677/2080/6573/files/shop-washes.jpg?v=1729697259\" alt=\"\"/>\n        </div>\n        <h3>Shop<br/> Conditioners</h3>\n    </li>\n    <li>\n      <div class=\"img-box\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0677/2080/6573/files/shop-conditioner.jpg?v=1729697259\" alt=\"\"/>\n      </div>\n      <h3>Shop<br/> Ears & Eyes</h3>\n    </li>\n  </ul>\n</div>",
