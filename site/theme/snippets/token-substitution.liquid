{%- comment -%}
  Furgenics token substitution pipeline (shared)
  ===
  Takes a `text` parameter and returns the substituted string.
  Single source of truth for [[PRICE]] / [[VALUE]] / [[COMPETITOR]] / [[DISCOUNT]] tokens.

  Called by:
    - sections/main-product.liquid           (product descriptions)
    - sections/main-page-pillar.liquid       (pillar page bodies)
    - snippets/furgenics-product-faqs.liquid (visible FAQ accordion)
    - snippets/furgenics-schema.liquid       (FAQPage JSON-LD schema)

  When adding a new PRICE handle, VALUE key, or COMPETITOR slug:
  edit this file only. All four call sites pick up the change automatically.

  Maintenance reference: brands/furgenics/knowledge/content-style-guide.md
{%- endcomment -%}

{%- assign rendered = text -%}

{%- comment -%} [[PRICE:handle]] — Markets-aware Furgenics product prices {%- endcomment -%}
{%- assign furgenics_handles = "hypoallergenic-shampoo-gallon,2in1-hypoallergenic-shampoo-conditioner,oatmeal-aloe-conditioner-gallon,oatmeal-aloe-shampoo-gallon,deshedding-shampoo,deshedding-conditioner,2in1-doodle-shampoo-conditioner,deep-moisturizing-conditioner-gallon,lavender-spa-shampoo" | split: "," -%}
{%- for handle in furgenics_handles -%}
  {%- assign price_token = '[[PRICE:' | append: handle | append: ']]' -%}
  {%- if rendered contains price_token -%}
    {%- assign tprod = all_products[handle] -%}
    {%- if tprod != blank and tprod.price != blank -%}
      {%- assign price_value = tprod.price | money -%}
      {%- assign rendered = rendered | replace: price_token, price_value -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} [[VALUE:key]] — invariant value-math claims {%- endcomment -%}
{%- assign rendered = rendered | replace: '[[VALUE:dilution-ratio]]', '16:1 concentrate' -%}
{%- assign rendered = rendered | replace: '[[VALUE:working-gallons-per-bottle]]', 'up to 17 working gallons per bottle at professional dilution' -%}
{%- assign rendered = rendered | replace: '[[VALUE:per-working-gallon-cost-narrative]]', 'roughly the cost of a cup of coffee per working gallon at pro dilution' -%}
{%- assign rendered = rendered | replace: '[[VALUE:made-in-canada]]', 'Made in Canada' -%}
{%- assign rendered = rendered | replace: '[[VALUE:professional-grade]]', 'built for professional salons' -%}
{%- assign rendered = rendered | replace: '[[VALUE:pro-vs-retail-positioning]]', 'a professional concentrate designed for salon volume — not a retail bottle in a bigger size' -%}

