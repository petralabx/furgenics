{%- comment -%}
  Furgenics Product FAQ Section (Visual Display)
  -----------------------------------------------
  Renders FAQs visually on product pages using the custom.faqs metafield.
  Paired with furgenics-schema.liquid which provides the invisible JSON-LD.

  Use: Include this snippet in your product template where you want the FAQ
  section to appear (e.g., below the product description).

  Usage:
    {% render 'furgenics-product-faqs' %}
{%- endcomment -%}

{%- if product.metafields.custom.faqs -%}
  {%- assign faq_list = product.metafields.custom.faqs.value -%}
  {%- if faq_list.size > 0 -%}
    <div class="furgenics-faq" style="margin: 40px 0; padding: 32px 0; border-top: 1px solid #e5e5e5;">
      <h2 style="font-size: 28px; margin-bottom: 24px; font-weight: 600;">Frequently Asked Questions</h2>
      {%- for faq in faq_list -%}
        {%- capture rendered_q -%}{%- render 'token-substitution', text: faq.q -%}{%- endcapture -%}
        {%- capture rendered_a -%}{%- render 'token-substitution', text: faq.a -%}{%- endcapture -%}
        <details style="margin-bottom: 12px; padding: 16px 20px; background: #f8f8f8; border-radius: 8px; cursor: pointer;">
          <summary style="font-weight: 600; font-size: 16px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>{{ rendered_q }}</span>
            <span style="font-size: 24px; line-height: 1; margin-left: 12px;">+</span>
          </summary>
          <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #e0e0e0; line-height: 1.6; color: #333;">
            {{ rendered_a }}
          </div>
        </details>
      {%- endfor -%}
    </div>

    <style>
      .furgenics-faq details[open] summary span:last-child { transform: rotate(45deg); transition: transform 0.2s; }
      .furgenics-faq summary::-webkit-details-marker { display: none; }
      .furgenics-faq summary { outline: none; }
      .furgenics-faq details[open] { background: #f0f0f0; }
    </style>
  {%- endif -%}
{%- endif -%}
